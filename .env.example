# Copier en .env.local et remplir. Ne jamais commiter .env.local. Aucune de ces valeurs ne va dans le navigateur.

# Neon Postgres (chaîne poolée)
DATABASE_URL=
NEON_AUTH_BASE_URL=
NEON_AUTH_COOKIE_SECRET=
# S3-compatible storage. Generate a credential to fill in the key ID + secret.
AWS_ENDPOINT_URL_S3=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
S3_BUCKET=
ADMIN_SETUP_TOKEN=
# Emails autorisés à créer un compte administrateur (séparés par des virgules)
ADMIN_EMAILS=
CRON_SECRET=
TOKEN_SECRET=
APP_URL=
# Domaine de l'outil : ecom.nerix.site en production (boutiques : <boutique>.ecom.nerix.site). Vide en local = localhost:3000.
ROOT_DOMAIN=
# KPay (Mobile Money et carte, page hébergée). Clé kpay_test_... en bac à sable, kpay_live_... en production.
KPAY_API_KEY=
# Clé secrète (64 caractères hexadécimaux, affichée une seule fois dans le tableau de bord KPay)
KPAY_SECRET_KEY=
# Secret de signature des webhooks (URL à déclarer dans KPay : https://<domaine>/api/webhooks/kpay)
KPAY_WEBHOOK_SECRET=
