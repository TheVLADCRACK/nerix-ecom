# Copier en .env.local et remplir. Ne jamais commiter .env.local. Aucune de ces valeurs ne va dans le navigateur.

# Neon Postgres (chaîne poolée)
DATABASE_URL=
NEON_AUTH_BASE_URL=
NEON_AUTH_COOKIE_SECRET=
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
ADMIN_SETUP_TOKEN=
# Emails autorisés à créer un compte administrateur (séparés par des virgules)
ADMIN_EMAILS=
CRON_SECRET=
TOKEN_SECRET=
APP_URL=
# Domaine de l'outil : ecom.nerix.site en production (boutiques : <boutique>.ecom.nerix.site). Vide en local = localhost:3000.
ROOT_DOMAIN=
# SaasPay (paiement Mobile Money et carte). Clé sk_test_... en développement, sk_live_... en production.
SASPAY_API_KEY=
# Secret de signature du webhook (affiché une seule fois à sa création dans app.saspay.me)
SASPAY_WEBHOOK_SECRET=
# Email envoyé à SaasPay pour chaque client (la boutique ne demande pas d'email)
SASPAY_CUSTOMER_EMAIL=contact@nerix.site
